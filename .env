# Shared by both OpenELIS instances (each keeps its own database and keystores).
# Database superuser (postgres) password. The OpenELIS admin user starts with
# adminADMIN! and is changed inside OpenELIS after the first login.
ADMIN_PASSWORD=superuser
# Password of the clinlims database user the application connects with.
OE_DB_PASSWORD=clinlims

# Keystore and truststore the webapp and its FHIR server use for TLS. The certs
# service rebuilds the stores whenever these passwords change.
SSL_TRUSTSTORE_PATH=/etc/openelis-global/truststore
SSL_TRUSTSTORE_PASSWORD=tspass
SSL_KEYSTORE_PATH=/etc/openelis-global/keystore
SSL_KEYSTORE_PASSWORD=kspass

# Key that encrypts secrets stored in the database. Set it before the first
# start and keep it. An installation that predates this setting keeps using
# SSL_KEYSTORE_PASSWORD while the line is missing.
OE_ENCRYPTION_PASSWORD=kspass

# Host ports. Instance 1: https://localhost, instance 2: https://localhost:444.
OE1_HTTP_PORT=80
OE1_HTTPS_PORT=443
OE1_WEBAPP_HTTPS_PORT=8443
OE2_HTTP_PORT=81
OE2_HTTPS_PORT=444
OE2_WEBAPP_HTTPS_PORT=8444

# FHIR Data Pipes controllers (one per instance) and their Java heap.
PIPELINE_PORT=8095
PIPELINE2_PORT=8096
PIPELINE_HEAP=2g

# SHR (central HAPI FHIR server).
SHR_PORT=8090
